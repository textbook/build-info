{
  "name": "@textbook/build-info",
  "version": "1.5.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Generate build information for tracking deployments",
  "type": "module",
  "bin": {
    "buildinfo": "lib/cli.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./rollup-plugin": "./lib/rollup.js"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/"
  ],
  "engines": {
    "node": ">=18.3"
  },
  "scripts": {
    "prebuild": "rimraf lib/",
    "build": "tsc --project ./tsconfig.build.json",
    "dev": "node --watch src/cli.ts",
    "pree2e": "npm run build",
    "e2e": "npm run e2e:html && npm run e2e:output && npm run e2e:stdout",
    "e2e:html": "npm --silent run start -- --format html --output out.html",
    "e2e:output": "npm run start -- -o 'out.txt'",
    "e2e:stdout": "node lib/cli.js > 'out.txt'",
    "lint": "eslint .",
    "start": "node lib/cli.js",
    "ship": "npm run lint && npm run test:coverage && npm run e2e",
    "test": "mocha",
    "test:coverage": "c8 npm run test",
    "test:mutation": "stryker run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/textbook/build-info.git"
  },
  "keywords": [
    "rollup-plugin",
    "vite-plugin"
  ],
  "author": "Jonathan Sharpe <mail@jonrshar.pe>",
  "funding": "https://ko-fi.com/textbook",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/textbook/build-info/issues"
  },
  "homepage": "https://github.com/textbook/build-info#readme",
  "devDependencies": {
    "@codeyourfuture/eslint-config-standard": "^8.1.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/mocha-runner": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@tsconfig/node18": "^18.2.7",
    "@types/chai": "^5.2.3",
    "@types/eslint": "^9.6.1",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.130",
    "@types/sinon": "^22.0.1",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-mocha": "^12.0.2",
    "jsdom": "^30.1.3",
    "mocha": "^11.8.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.65.0",
    "sinon": "^22.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
